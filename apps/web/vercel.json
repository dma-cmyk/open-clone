{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://open-clone-api.dma-cmyk.workers.dev wss://open-clone-api.dma-cmyk.workers.dev https://challenges.cloudflare.com; frame-src 'self' blob: data: https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "https://open-clone-api.dma-cmyk.workers.dev/v1/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-oc-edge-secret"
          },
          "args": "$OC_EDGE_SECRET",
          "env": [
            "OC_EDGE_SECRET"
          ]
        }
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "https://open-clone-api.dma-cmyk.workers.dev/v1/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-oc-edge-secret"
          },
          "args": "$OC_EDGE_SECRET",
          "env": [
            "OC_EDGE_SECRET"
          ]
        }
      ]
    },
    {
      "src": "/compat/(.*)",
      "dest": "https://open-clone-api.dma-cmyk.workers.dev/compat/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-oc-edge-secret"
          },
          "args": "$OC_EDGE_SECRET",
          "env": [
            "OC_EDGE_SECRET"
          ]
        }
      ]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
