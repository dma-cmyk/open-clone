    "db:setup": "bash scripts/start-api.sh --setup-only"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
