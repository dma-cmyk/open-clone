{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --list",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test smoke.spec.ts",
    "test:e2e:security": "playwright test security",
    "test:e2e:pc": "playwright test --project=pc",
    "stubs": "node scripts/stub-server.mjs",
