# ============================================================
# open-clone 環境変数一覧（キー名のみ。値は絶対に commit しない）
# ============================================================

# --- web (apps/web / Vercel) ---
# 直接モード時のみ設定。未設定なら同一オリジン /api/v1（rewrites プロキシ）
# NEXT_PUBLIC_API_BASE=https://api.example.com/v1
# プラグイン作成トークン画面（/account/plugin-tokens）に表示する MCP の API オリジン。
# 未設定なら apps/web/vercel.json のプロキシ先（https://open-clone-api.dma-cmyk.workers.dev）を使う。
# 接続手順には「この値 + /mcp-plugin」を表示する（報告書29 決定9）。
NEXT_PUBLIC_API_ORIGIN=https://open-clone-api.dma-cmyk.workers.dev

# --- api (apps/api / Cloudflare Worker) ---
# ローカルは apps/api/.dev.vars（gitignore 済み）に書く。本番は wrangler secret put。
# 表示ID/端末ハッシュの pepper（本番は十分長い乱数）
ID_SALT=
# D1 に暗号化保存する GitHub トークン等の AES-256-GCM 鍵（32bytes base64）
ENC_KEY=
# owner 初期セットアップの一度きりキー
OWNER_BOOTSTRAP_KEY=
# Turnstile secret（本番）。ローカルは公式テストキー 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Turnstile site key（公開可。ローカルは 1x00000000000000000000AA）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# GitHub OAuth App（WP4）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Cloudinary（WP4 signed upload）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
